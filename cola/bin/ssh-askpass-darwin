#! /bin/sh
# SSH_ASKPASS helper for macOS: ask for a passphrase or a yes/no answer.
#
# The dialog comes from osascript itself rather than "tell application
# Finder", which needs Automation consent and failed silently when it was
# denied. The prompt and title are passed as arguments, not spliced into the
# AppleScript source, so quotes or backslashes in them cannot break it.
title=${MACOS_ASKPASS_TITLE:-SSH}
prompt="$*"

# Host key questions ("Are you sure ... (yes/no)?") show what is typed.
hidden=true
case "$prompt" in
*"'yes'"* | *yes/no*)
	hidden=false
	;;
esac

osascript - "$prompt" "$title" "$hidden" 2>/dev/null <<'EOF'
on run argv
	set dialogPrompt to item 1 of argv
	set dialogTitle to item 2 of argv
	set hideAnswer to (item 3 of argv) is "true"
	activate
	set reply to display dialog dialogPrompt default answer "" with title dialogTitle with icon caution hidden answer hideAnswer
	return text returned of reply
end run
EOF

#!/bin/sh

# $0 = Contents/MacOS/git-cola
# macos = Contents/MacOS
macos="$(dirname "$0")"
# contents = Contents
contents="$(dirname "$macos")"
# resources = Contents/Resources
resources="${contents}/Resources"

# Finder and the Dock start apps with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin),
# where git is Apple's Command Line Tools shim and git-lfs, gpg, gh and
# Homebrew editors and diff tools are missing. Put the common install
# locations first, Apple Silicon Homebrew first of all, so the app finds the
# same tools as a terminal: git-osx-installer, Intel Homebrew, MacPorts.
for dir in /usr/local/git/bin /usr/local/bin /opt/local/bin /opt/homebrew/sbin /opt/homebrew/bin
do
	if test -d "$dir"
	then
		PATH="${dir}:${PATH}"
	fi
done
PATH="${resources}/bin:${PATH}"
export PATH

# Started from Finder or the Dock there are no arguments: ask for a
# repository. Another git-cola started from the app passes --repo.
if test $# -eq 0
then
	set -- --prompt
fi

# Run the bundle's own copy of the interpreter. macOS identifies a process
# by the bundle its executable is in, and the venv's python is a symlink to
# an interpreter outside the app, so the app had no bundle id: no Git Cola
# name or icon in Cmd-Tab, and its windows weren't the app's.
# __PYVENV_LAUNCHER__ tells that interpreter to use the bundle's venv.
if test -x "${macos}/python"
then
	__PYVENV_LAUNCHER__="${resources}/bin/python"
	export __PYVENV_LAUNCHER__
	exec "${macos}/python" "${resources}/bin/git-cola" "$@"
fi
exec python "${resources}/bin/git-cola" "$@"
